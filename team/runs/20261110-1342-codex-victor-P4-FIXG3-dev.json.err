function listIgnoredFilesOutsideNodeModules(repo: string): string[] {
  try {
    const topEntries = readdirSync(repo).filter((name) => name !== '.git' && name !== 'node_modules');
    if (topEntries.length === 0) return [];
    const out = git(repo, 'ls-files', '--others', '-i', '--exclude-standard', '-z', '--', ...topEntries);
    if (!out) return [];
    return out
      .split('\0')
      .map((p) => p.replace(/\\/g, '/'))
      .filter(Boolean)
      .sort();
  } catch {
    return [];
  }
}

function snapshotNodeModulesBin(repo: string): Record<string, string> {
  const result: Record<string, string> = {};
  const binDir = join(repo, 'node_modules', '.bin');
  if (!existsSync(binDir)) return result;

  function walk(dir: string, prefix: string) {
    let entries;
    try {
      entries = readdirSync(dir, { withFileTypes: true });
    } catch {
      return;
    }
    for (const ent of entries) {
      const rel = prefix ? `${prefix}/${ent.name}` : ent.name;
      const fullPath = join(dir, ent.name);
      try {
        const st = lstatSync(fullPath);
        if (st.isSymbolicLink()) {
          result[rel] = `symlink:${readlinkSync(fullPath)}`;
        } else if (st.isDirectory()) {
          walk(fullPath, rel);
        } else if (st.isFile()) {
          const hash = createHash('sha256').update(readFileSync(fullPath)).digest('hex');
          result[rel] = `file:${hash}`;
        }
      } catch {}
    }
  }
  walk(binDir, '');
  return result;
}

const PKG_MANIFEST_FILES = ['package.json', 'package-lock.json', 'pnpm-lock.yaml', 'yarn.lock'];

function snapshotPkgManifests(repo: string): Record<string, string> {
  const res: Record<string, string> = {};
  for (const f of PKG_MANIFEST_FILES) {
    const p = join(repo, f);
    if (existsSync(p)) {
      try {
        res[f] = createHash('sha256').update(readFileSync(p)).digest('hex');
      } catch {
        res[f] = '';
      }
    } else {
      res[f] = '';
    }
  }
  return res;
}

function didPkgManifestsChange(repo: string, snapshot: TurnGuardSnapshot): boolean {
  if (!snapshot.pkgManifestHashes) return false;
  const cur = snapshotPkgManifests(repo);
  for (const f of PKG_MANIFEST_FILES) {
    if ((snapshot.pkgManifestHashes[f] ?? '') !== (cur[f] ?? '')) {
      return true;
    }
  }
  return false;
}

export function cleanPlantedIgnoredFiles(
  repo: string,
  snapshot: TurnGuardSnapshot,
  seat?: Seat
): { planted: boolean; cleanedCount: number } {
  let planted = false;
  let cleanedCount = 0;

  if (snapshot.ignoredFiles !== undefined) {
    const preSet = new Set(snapshot.ignoredFiles);
    const currentIgnored = listIgnoredFilesOutsideNodeModules(repo);
    for (const relPath of currentIgnored) {
      if (!preSet.has(relPath)) {
        cleanedCount++;
